<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="soor_language_switcher" inherit_id="website.layout" name="SOOR Language Switcher">
        <xpath expr="//div[@id='wrapwrap']" position="before">
            <t t-if="request.website and len(request.website.language_ids) > 1">
                <t t-set="languages" t-value="request.website.language_ids.sorted(key=lambda r: r.name)"/>
                <div class="o_language_switcher dropup d-print-none">
                    <button class="btn dropdown-toggle o-lang-btn" type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" t-att-title="request.lang.name or 'Language'">
                        <img t-att-src="'/web/image/res.lang/%d/flag_image' % request.lang.id"
                             class="o-lang-btn__flag" t-att-alt="request.lang.name" width="22" height="15"/>
                        <span class="o-lang-btn__code" t-esc="(request.lang.iso_code or request.lang.code[:2]).upper()"/>
                    </button>
                    <div class="dropdown-menu">
                        <t t-foreach="languages" t-as="lg">
                            <a t-att-href="url_for(request.httprequest.path + '?' + keep_query(), lang_code=lg.code)"
                               t-attf-class="dropdown-item #{'active' if request.lang == lg else ''}">
                                <span t-esc="lg.name"/>
                            </a>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
