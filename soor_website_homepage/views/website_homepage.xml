<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Toolbar only (stays in header). Checkbox + drawer live under #wrap so .soor-hero overflow:hidden cannot clip the panel. -->
    <template id="soor_mnav_toolbar" name="SOOR mobile nav toolbar">
        <div class="soor-topbar__mobile">
            <a href="/contactus" class="soor-nav-contact-cta soor-mnav__contact-cta">
                <span class="soor-nav-contact-cta__label">Contact Us</span>
                <span class="soor-nav-contact-cta__arrow" aria-hidden="true">
                    <svg width="14" height="10" viewBox="0 0 18 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 6h12M11 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
            </a>
            <label t-attf-for="#{mnav_id}" class="soor-mnav__burger" aria-label="Open menu">
                <span class="soor-mnav__burger-line"/>
                <span class="soor-mnav__burger-line"/>
                <span class="soor-mnav__burger-line"/>
            </label>
        </div>
    </template>

    <template id="soor_mnav_overlay" name="SOOR mobile nav overlay">
        <input type="checkbox" t-att-id="mnav_id" class="soor-mnav__chk" autocomplete="off" tabindex="-1"/>
        <label t-attf-for="#{mnav_id}" class="soor-mnav__backdrop" aria-hidden="true"/>
        <div class="soor-mnav__panel soor-mnav__panel--sheet" role="dialog" aria-label="Site menu">
            <div class="soor-mnav__panel-head">
                <label t-attf-for="#{mnav_id}" class="soor-mnav__close" aria-label="Close menu">×</label>
            </div>
            <div class="soor-mnav__panel-body">
                <nav class="soor-mnav__links soor-mnav__links--sheet" aria-label="Site">
                    <a href="/" class="soor-mnav__row">Home</a>
                    <a href="/about" class="soor-mnav__row">About Us</a>
                    <a href="/blogs" class="soor-mnav__row">Blog</a>
                    <a href="/services" class="soor-mnav__row">Services</a>
                    <details class="soor-mnav__more-sheet">
                        <summary class="soor-mnav__more-sheet__summary">
                            <span class="soor-mnav__more-sheet__label">More</span>
                            <span class="soor-mnav__more-sheet__caret" aria-hidden="true">
                                <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                        </summary>
                        <div class="soor-mnav__more-sheet__list">
                            <a href="/odoo" class="soor-mnav__row soor-mnav__row--sub">Odoo</a>
                            <a href="/hessapay" class="soor-mnav__row soor-mnav__row--sub">Hessa Pay</a>
                            <a href="/soor_website_homepage/static/src/pdf/Digital-Profile.pdf" target="_blank" rel="noopener noreferrer" class="soor-mnav__row soor-mnav__row--sub">Digital Profile</a>
                        </div>
                    </details>
                </nav>
            </div>
        </div>
    </template>

    <template id="soor_homepage_override" inherit_id="website.homepage" name="SOOR Homepage">
        <xpath expr="//t[@t-set='pageName']" position="after">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
        </xpath>
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty soor-page">
                <t t-call="soor_website_homepage.soor_mnav_overlay">
                    <t t-set="mnav_id" t-value="'soor-mnav-home'"/>
                </t>
