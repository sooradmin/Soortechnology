                            </a>
                            <ul class="soor-nav soor-nav--desktop">
                                <li><a href="/">Home</a></li>
                                <li><a href="/services">Services</a></li>
                                <li><a href="/about">About Us</a></li>
                                <li><a href="/blogs">Blog</a></li>
